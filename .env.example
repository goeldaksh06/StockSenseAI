# Database URL (SQLite for dev, PostgreSQL for prod — e.g. Render/Railway managed Postgres)
DATABASE_URL=sqlite:///./stocksense.db

# JWT Configuration — generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
JWT_ALGORITHM=HS256

# Flask/session secret (same generation method as above)
SECRET_KEY=

ENV=production

# News API (https://newsapi.org/register) — used for headline sentiment
NEWS_API_KEY=

# LLM briefing feature — pick one provider
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# CORS — comma-separated list of allowed frontend origins in production
ALLOWED_ORIGINS=http://127.0.0.1:8000

PORT=8000
